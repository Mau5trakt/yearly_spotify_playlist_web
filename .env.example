# ==========================================
# Spotify Developer Dashboard Credentials
# ==========================================
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Spotify OAuth requires the literal 127.0.0.1 loopback IP in development (localhost is prohibited)
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/auth/callback"

# ==========================================
# Encrypted Session (iron-session)
# ==========================================
# Random secret key of at least 32 characters for sealing HttpOnly cookies
SESSION_PASSWORD="complex_password_at_least_32_characters_long_for_spotify_app_2025"

# ==========================================
# Public App Base URL
# ==========================================
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
